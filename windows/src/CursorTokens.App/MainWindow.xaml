<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CursorTokens.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cursor Tokens">
    <Grid>
        <ScrollViewer x:Name="SignedOutView" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="12">
                <TextBlock Text="Cursor Tokens" FontSize="28" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" Text="Sign in with the Cursor account already on this PC, or paste a WorkosCursorSessionToken from cursor.com." />
                <Button x:Name="LocalButton" Content="Use the account signed in to Cursor" Click="LocalButton_Click" HorizontalAlignment="Left" />
                <Button x:Name="BrowserButton" Content="Open cursor.com" Click="BrowserButton_Click" HorizontalAlignment="Left" />
                <PasswordBox x:Name="TokenBox" PlaceholderText="Session token" />
                <Button x:Name="PasteButton" Content="Sign in with token" Click="PasteButton_Click" HorizontalAlignment="Left" />
                <TextBlock x:Name="SignInError" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SignedInView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="16">
                <TextBlock Text="Cursor Tokens" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="MembershipText" FontSize="14" />
                <TextBlock x:Name="EmailText" FontSize="14" />
                <TextBlock Text="Included" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Cursor models" />
                <TextBlock x:Name="CursorPercent" FontWeight="SemiBold" />
                <ProgressBar x:Name="CursorBar" Maximum="100" />
                <TextBlock Text="Other models" />
                <TextBlock x:Name="OtherPercent" FontWeight="SemiBold" />
                <ProgressBar x:Name="OtherBar" Maximum="100" />
                <StackPanel x:Name="OnDemandPanel" Spacing="8">
                    <TextBlock Text="On-demand" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Usage" />
                    <TextBlock x:Name="OnDemandUsage" FontWeight="SemiBold" />
                    <TextBlock Text="Spend limit" />
                    <TextBlock x:Name="OnDemandLimit" FontWeight="SemiBold" />
                    <ProgressBar x:Name="OnDemandBar" Maximum="100" />
                </StackPanel>
                <TextBlock Text="Tokens" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Today" />
                <TextBlock x:Name="TodayText" FontWeight="SemiBold" />
                <TextBlock Text="7 days" />
                <TextBlock x:Name="WeekText" FontWeight="SemiBold" />
                <TextBlock Text="30 days" />
                <TextBlock x:Name="MonthText" FontWeight="SemiBold" />
                <TextBlock x:Name="UpdatedText" FontSize="12" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Refresh" Click="RefreshButton_Click" />
                    <Button Content="Sign out" Click="SignOutButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
